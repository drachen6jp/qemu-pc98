/*
 * Minimal PC98 BIOS
 * Copyright (C) 2026 Awe Morris
 *
 * Generated by diffing low RAM against the stock Xa7 firmware at the
 * instant control reaches the main BIOS entry (0xFD802).  These are the
 * work-area cells the NEC ITF leaves behind and the BIOS then reads.
 * The protected-mode resume pointer at 0x404/0x406 is deliberately left
 * out: the BIOS writes that itself before each reset.  So is 0x5BA, the
 * IDE probe mask -- the disk BIOS tests a bit per drive there before it
 * will record that drive's geometry, and the stock value at handoff is
 * zero only because the BIOS fills it in later from its own probe.
 * Format: offset, value.
 */
wa_seed_table:
	.word	0x0400
	.byte	0x02
	.word	0x0457
	.byte	0x97
	.word	0x045a
	.byte	0xa2
	.word	0x045b
	.byte	0x84
	.word	0x045c
	.byte	0x40
	.word	0x045d
	.byte	0x48
	.word	0x0480
	.byte	0xd3
	.word	0x0484
	.byte	0x0e
	.word	0x04f1
	.byte	0x1c
	.word	0x0500
	.byte	0x01
	.word	0x054d
	.byte	0x40
	.word	0x055d
	.byte	0x01
	.word	0x0597
	.byte	0x84
	.word	0x059a
	.byte	0x58
	.word	0x059b
	.byte	0x02
	.word	0x05b0
	.byte	0x07
wa_seed_table_end:
